{
  "rewrites": [
    {
      "source": "/watch/:id",
      "destination": "/api/video_preview?id=:id"
    },
    {
      "source": "/tag/:tag",
      "destination": "/api/tag_preview?tag=:tag"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ]
}